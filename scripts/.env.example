# Kopier denne til scripts/.env. scripts/.env er gitignored og skal aldri committes.

# SSH-target for scp/ssh (user@host)
SERVER=user@your-server.example.com

# Absolutt sti på serveren der filene legges (serveres som /updates/luna3d/)
REMOTE_DIR=/opt/lunachat/releases/luna3d

# Offentlig base-URL — må matche endpointen i src-tauri/tauri.conf.json
PUBLIC_BASE=https://lunaeco.no/updates/luna3d
