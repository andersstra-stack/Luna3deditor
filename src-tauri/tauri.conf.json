{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luna 3D",
  "version": "../package.json",
  "identifier": "no.luna.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Luna 3D",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripting/luna3d.py": "scripting/luna3d.py"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://lunaeco.no/updates/luna3d/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4NEJCQTJCNTQyQzgzNzMKUldSemd5eFVLN3BMT011aGFqaEhXbjlPaEpHVndhZlR0akU0QWc5c203SFlaTGZnRWtEMDZUNFkK"
    }
  }
}
